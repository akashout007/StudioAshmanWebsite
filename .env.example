# Contact form email (Resend). Set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values. .env.local is git-ignored for local testing.

# Required. API key from https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Sender address; its domain (studioashman.com) must be verified in Resend.
# Defaults to: Ashman Studio website <website@studioashman.com>
CONTACT_FROM_EMAIL=

# Optional. Where enquiries are delivered. Defaults to work@studioashman.com
CONTACT_TO_EMAIL=
